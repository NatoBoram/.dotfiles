{
	"inputs": [
		{
			"description": "Tavily API Key",
			"id": "tavily_api_key",
			"password": true,
			"type": "promptString"
		},
		{
			"description": "Context7 API Key",
			"id": "context7_api_key",
			"password": true,
			"type": "promptString"
		}
	],
	"servers": {
		"context7": {
			"headers": {
				"CONTEXT7_API_KEY": "${input:context7_api_key}"
			},
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"dart": {
			"args": ["mcp-server"],
			"command": "dart",
			"type": "stdio"
		},
		"deepwiki": {
			"type": "http",
			"url": "https://mcp.deepwiki.com/mcp"
		},
		"exa": {
			"type": "http",
			"url": "https://mcp.exa.ai/mcp"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp"
		},
		"go": {
			"args": ["mcp"],
			"command": "gopls",
			"type": "stdio"
		},
		"grep": {
			"type": "http",
			"url": "https://mcp.grep.app"
		},
		"markitdown": {
			"args": ["run", "markitdown-mcp"],
			"command": "pipx",
			"type": "stdio"
		},
		"mdn": {
			"type": "http",
			"url": "https://mcp.mdn.mozilla.net"
		},
		"playwright": {
			"args": ["@playwright/mcp@latest"],
			"command": "bunx",
			"tools": ["*"],
			"type": "stdio"
		},
		"stackoverflow": {
			"type": "http",
			"url": "https://mcp.stackoverflow.com"
		},
		"svelte": {
			"tools": ["*"],
			"type": "http",
			"url": "https://mcp.svelte.dev/mcp"
		},
		"tavily": {
			"args": ["tavily-mcp@latest"],
			"command": "bunx",
			"env": {
				"TAVILY_API_KEY": "${input:tavily_api_key}"
			},
			"type": "stdio"
		}
	}
}
