{
	"inputs": [
		{
			"description": "Tavily API Key",
			"id": "tavily_api_key",
			"password": true,
			"type": "promptString"
		},
		{
			"description": "Context7 API Key",
			"id": "context7_api_key",
			"password": true,
			"type": "promptString"
		}
	],
	"servers": {
		"context7": {
			"gallery": "https://api.mcp.github.com",
			"headers": {
				"CONTEXT7_API_KEY": "${input:context7_api_key}"
			},
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"version": "1.0.0"
		},
		"deepwiki": {
			"gallery": "https://api.mcp.github.com",
			"type": "http",
			"url": "https://mcp.deepwiki.com/mcp",
			"version": "1.0.0"
		},
		"exa": {
			"type": "http",
			"url": "https://mcp.exa.ai/mcp"
		},
		"github": {
			"gallery": "https://api.mcp.github.com",
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp",
			"version": "0.13.0"
		},
		"grep": {
			"type": "http",
			"url": "https://mcp.grep.app"
		},
		"mdn": {
			"type": "http",
			"url": "https://mcp.mdn.mozilla.net"
		},
		"playwright": {
			"args": ["@playwright/mcp@latest"],
			"command": "bunx",
			"tools": ["*"],
			"type": "stdio"
		},
		"stackoverflow": {
			"gallery": "https://api.mcp.github.com",
			"type": "http",
			"url": "https://mcp.stackoverflow.com",
			"version": "1.1.3"
		},
		"tavily": {
			"args": ["tavily-mcp@latest"],
			"command": "bunx",
			"env": {
				"TAVILY_API_KEY": "${input:tavily_api_key}"
			},
			"type": "stdio"
		}
	}
}
